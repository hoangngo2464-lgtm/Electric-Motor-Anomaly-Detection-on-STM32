/* USER CODE BEGIN 0 */

/**
 * @brief  �?i�?u khiển motor qua DRV8871 (sơ đồ IN1/IN2)
 * @param  dir: 1 = quay thuận (IN2 = LOW), 0 = quay nghịch (IN2 = HIGH)
 * @param  duty: 0..49 (tương ứng 0%..100%)
 * @note   DRV8871: IN1 = PWM (PA1), IN2 = GPIO (PB0)
 *         - Thuận: IN1 = PWM, IN2 = LOW
 *         - Nghịch: IN1 = PWM, IN2 = HIGH
 */
void Motor_Control(uint8_t dir, uint16_t duty)
{
    if (duty > PWM_PERIOD) duty = PWM_PERIOD;

    if (dir == 1) {
        /* Quay thuận */
        HAL_GPIO_WritePin(motor_dir_GPIO_Port, motor_dir_Pin, GPIO_PIN_RESET);
        __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, duty);
    } else {
        /* Quay nghịch */
        HAL_GPIO_WritePin(motor_dir_GPIO_Port, motor_dir_Pin, GPIO_PIN_SET);
        __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, duty);
    }
}

/**
 * @brief  Dừng motor (coast)
 */
void Motor_Stop(void)
{
    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, 0);
    HAL_GPIO_WritePin(motor_dir_GPIO_Port, motor_dir_Pin, GPIO_PIN_RESET);
}

/**
 * @brief  �?�?c encoder và tính RPM
 * @note   Dùng uint16_t + tràn số bù hai để xử lý counter 16-bit
 */
void Read_Encoder(void)
{
    encoder_now  = (uint16_t)__HAL_TIM_GET_COUNTER(&htim3);
    delta_pulse  = (int16_t)(encoder_now - encoder_last);
    encoder_last = encoder_now;

    /* RPM = (delta / PULSES_PER_REV) × (60 / T_giây)
       T = 0.1s → 60/0.1 = 600 */
    rpm = ((float)delta_pulse * 600.0f) / PULSES_PER_REV;
}

/**
 * @brief  �?�?c INA219 (V, I, P)
 */
void Read_INA219(void)
{
    voltage_V  = INA219_GetBusVoltage_V(&hi2c1);
    current_mA = INA219_GetCurrent_A(&hi2c1) * 1000.0f;
    power_mW   = INA219_GetPower_W(&hi2c1) * 1000.0f;

    /* L�?c giá trị rác âm nh�? */
    if (voltage_V < 0.0f)  voltage_V = 0.0f;
    if (current_mA < 0.0f && current_mA > -5.0f) current_mA = 0.0f;
    if (power_mW  < 0.0f)  power_mW = 0.0f;
}

/**
 * @brief  Kiểm tra ngưỡng bảo vệ (2 cấp)
 */
void Check_Protection(void)
{
    /* B�? qua 5 giây đầu sau khởi động để INA219 ổn định */
    if (HAL_GetTick() < 5000) {
        critical_flag = 0;
        warning_flag  = 0;
        return;
    }

    /* Sự cố nặng → dừng hẳn */
    if (current_mA > (CRITICAL_CURRENT_A * 1000.0f) ||
        (voltage_V > 0.1f && voltage_V < CRITICAL_VOLTAGE_V)) {
        critical_flag = 1;
        Motor_Stop();
        return;
    }

    /* Hết sự cố nặng → cho phép chạy lại */
    critical_flag = 0;

    /* Sự cố nhẹ → giảm PWM */
    if (current_mA > (WARNING_CURRENT_A * 1000.0f) ||
        (voltage_V > 0.1f && voltage_V < WARNING_VOLTAGE_V)) {
        warning_flag = 1;
    } else {
        warning_flag = 0;
    }
}

/**
 * @brief  Cập nhật LCD 16x2
 */
void Update_LCD(void)
{
    int v_nguyen   = (int)voltage_V;
    int v_thapphan = (int)(voltage_V * 100.0f) % 100;
    if (v_thapphan < 0) v_thapphan = -v_thapphan;

    int i_mA = (int)current_mA;
    if (i_mA < 0) i_mA = 0;

    /* Hàng 1: V và I */
    snprintf(lcd_buf, sizeof(lcd_buf), "V:%2d.%02dV I:%4dmA",
             v_nguyen, v_thapphan, i_mA);
    LCD_SetCursor(0, 0);
    LCD_Print(lcd_buf);

    /* Hàng 2: RPM */int rpm_val = (int)rpm;
    if (rpm_val < 0) rpm_val = -rpm_val;

    snprintf(lcd_buf, sizeof(lcd_buf), "Speed: %4d RPM  ", rpm_val);
    LCD_SetCursor(0, 1);
    LCD_Print(lcd_buf);
}

/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM3_Init();
  MX_I2C1_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */

  /* 1. Khởi động PWM và Encoder */
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_2);
  HAL_TIM_Encoder_Start(&htim3, TIM_CHANNEL_ALL);

  /* 2. Reset counter encoder v�? 0 */
  __HAL_TIM_SET_COUNTER(&htim3, 0);
  encoder_last = 0;

  /* 3. Dừng motor ban đầu để an toàn */
  Motor_Stop();

  /* 4. Khởi tạo LCD */
  if (LCD_Init()) {
      LCD_Clear();
      LCD_SetCursor(0, 0);
      LCD_Print("System Starting ");
      HAL_Delay(1000);
      LCD_Clear();
  }

  /* 5. Khởi tạo INA219 (ghi Config + Calibration) */
  if (INA219_Init(&hi2c1) != HAL_OK) {
      LCD_SetCursor(0, 0);
      LCD_Print("INA219 FAIL!    ");
      HAL_Delay(2000);
  }

  /* 6. Ch�? hệ thống ổn định */
  HAL_Delay(500);

  /* 7. Bắt đầu nhận UART ngắt (Vui lòng bật USART1 trong CubeMX) */
  /* B�? comment dòng dưới sau khi cấu hình UART1 trong CubeMX */
  // extern UART_HandleTypeDef huart1;
  // HAL_UART_Receive_IT(&huart1, &rx_data, 1);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* ============================================
     * BƯ�?C 1: �?IỀU KHIỂN MOTOR
     * ============================================ */
    if (critical_flag) {
        Motor_Stop();
    } else if (warning_flag) {
        if (motor_state == 1) Motor_Control(1, PWM_DUTY_50);      /* Thuận giảm 50% */
        else if (motor_state == 2) Motor_Control(0, PWM_DUTY_50); /* Nghịch giảm 50% */
        else Motor_Stop();
    } else {
        if (motor_state == 1) Motor_Control(1, PWM_DUTY_100);     /* Thuận 100% */
        else if (motor_state == 2) Motor_Control(0, PWM_DUTY_100);/* Nghịch 100% */
        else Motor_Stop();
    }

    /* ============================================
     * BƯ�?C 2: CHỜ LẤY MẪU
     * ============================================ */
    HAL_Delay(SAMPLE_PERIOD_MS);

    /* ============================================
     * BƯ�?C 3: �?ỌC ENCODER → RPM
     * ============================================ */
    Read_Encoder();

    /* ============================================
     * BƯ�?C 4: �?ỌC INA219 → V, I, P
     * ============================================ */
    Read_INA219();

    /* ============================================
     * BƯ�?C 5: KIỂM TRA BẢO VỆ
     * ============================================ */
    Check_Protection();

    /* ============================================
     * BƯ�?C 6: HIỂN TH�? LCD
     * ============================================ */
    Update_LCD();

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

