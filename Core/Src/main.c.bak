/* ==================== THÔNG S�? HỆ TH�?NG ==================== */

/* PWM: 72MHz / ((71+1) × (49+1)) = 20 kHz */
#define PWM_PERIOD          49      /* ARR = 49 → duty 0..49 */
#define PWM_DUTY_100        49      /* Duty 100% */
#define PWM_DUTY_50         25      /* Duty 50% */
#define PWM_DUTY_0          0       /* Duty 0% (dừng) */

/* Encoder 25GA-370 12V 130RPM:
   - 11 PPR (xung/vòng motor)
   - Giảm tốc 47:1 (theo bảng thông số 25GA-370)
   - Xung/vòng trục ra = 11 × 47 = 517
   - Dùng TI12 (x4 decoding) → 517 × 4 = 2068 */
#define PULSES_PER_REV      2068.0f

/* Chu kỳ lấy mẫu (ms) */
#define SAMPLE_PERIOD_MS    100

/* Ngưỡng bảo vệ (theo bảng thông số 25GA-370 12V 130RPM)
 * No-Load: 0.14A, Rated: 0.6A, Stall: 4A */
#define WARNING_CURRENT_A   2.0f
#define CRITICAL_CURRENT_A  4.5f
#define WARNING_VOLTAGE_V   10.5f
#define CRITICAL_VOLTAGE_V  9.5f

/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */
/* USER CODE END PM */

/* Private variables ---------------------------------------------------------*/
I2C_HandleTypeDef hi2c1;

TIM_HandleTypeDef htim2;
TIM_HandleTypeDef htim3;

/* USER CODE BEGIN PV */

/* --- Biến đo tốc độ động cơ --- */
uint16_t encoder_now = 0;
uint16_t encoder_last = 0;
int16_t  delta_pulse = 0;
float    rpm = 0.0f;

/* --- Biến INA219 --- */
float voltage_V   = 0.0f;
float current_mA  = 0.0f;
float power_mW    = 0.0f;

/* --- C�? bảo vệ --- */
uint8_t warning_flag  = 0;
uint8_t critical_flag = 0;

/* --- C�? đi�?u khiển từ UART --- */
uint8_t motor_state = 1; /* 1: Tự chạy quay thuận khi cấp nguồn */
uint8_t rx_data = 0;     /* Biến nhận 1 byte UART */

/* --- Bộ đệm LCD --- */
char lcd_buf[25];

/* USER CODE END PV */

